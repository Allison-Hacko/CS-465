
<div id="background">
    <div id="page">
        <div id="header">
            <div id="logo">
                <a href="/"><img src="/images/logo.png" alt="LOGO" height="100" width="200"></a>
            </div>
            <div id="navigation">
                <ul>
                    <li>
                        <a href="/">Home</a>
                    </li>
                    <li class="selected">
                        <a href="/travel">Travel</a>
                    </li>
                    <li>
                        <a href="/rooms">Rooms</a>
                    </li>
                    <li>
                        <a href="/meals">Meals</a>
                    </li>
                    <li>
                        <a href="/news">News</a>
                    </li>
                    <li>
                        <a href="/about">About</a>
                    </li>
                    <li>
                        <a href="/contact">Contact</a>
                    </li>
                </ul>
            </div>
        </div>

        <div id="contents">
            <div class="box">
                <div>
                    <div class="body">
                        <h1>Travel</h1>

                        <form action="/travel" method="GET">
                            <label for="search">Search trips by name or resort:</label>
                            <input
                                type="text"
                                id="search"
                                name="search"
                                value="{{searchTerm}}"
                                placeholder="Enter a trip or resort name"
                            >
                            <button type="submit">Search</button>
                            <a href="/travel">Clear</a>
                        </form>

                        {{#if noResults}}
                            <p>No trips matched your search. Try another name or resort.</p>
                        {{/if}}

                        <ul id="sites">
                            {{#each trips}}
                                <li>
                                    <a href="/travel">
                                        <img src="/images/{{image}}" alt="{{name}}">
                                    </a>
                                    <h2><a href="/travel">{{name}}</a></h2>
                                    <p>{{description}}</p>
                                    <p><strong>Resort:</strong> {{resort}}</p>
                                    <p><strong>Duration:</strong> {{length}}</p>
                                    <p><strong>Starting price:</strong> {{perPerson}}</p>
                                </li>
                            {{else}}
                                {{#unless ../noResults}}
                                    <li>No trips are currently available.</li>
                                {{/unless}}
                            {{/each}}
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="footer">
        <div>
            <ul class="navigation">
                <li>
                    <a href="/">Home</a>
                </li>
                <li class="active">
                    <a href="/travel">Travel</a>
                </li>
                <li>
                    <a href="/rooms">Rooms</a>
                </li>
                <li>
                    <a href="/meals">Meals</a>
                </li>
                <li>
                    <a href="/news">News</a>
                </li>
                <li>
                    <a href="/about">About</a>
                </li>
                <li>
                    <a href="/contact">Contact</a>
                </li>
            </ul>

            <div id="connect">
                <a href="http://pinterest.com/fwtemplates/" target="_blank" rel="noopener noreferrer" class="pinterest"></a>
                <a href="http://freewebsitetemplates.com/go/facebook/" target="_blank" rel="noopener noreferrer" class="facebook"></a>
                <a href="http://freewebsitetemplates.com/go/twitter/" target="_blank" rel="noopener noreferrer" class="twitter"></a>
                <a href="http://freewebsitetemplates.com/go/googleplus/" target="_blank" rel="noopener noreferrer" class="googleplus"></a>
            </div>
        </div>

        <p>
            &copy; 2023 by BHACCASYONIZTAS BEACH RESORT. All Rights Reserved
        </p>
    </div>
</div>
